# Copie este arquivo para ".env" e preencha os valores reais.

# Chave usada para assinar os tokens JWT. Troque por um valor aleatório e secreto.
SECRET_KEY=troque-esta-chave-por-uma-bem-aleatoria
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# URL de conexão do banco (SQLAlchemy). Se deixar em branco, usa SQLite local (arquivo .db).
# Para Postgres na nuvem (ex.: Supabase: Project Settings > Database > Connection string):
# DATABASE_URL=postgresql://postgres:SENHA@db.xxxxxxxx.supabase.co:5432/postgres
DATABASE_URL=

# Access Token da sua conta Mercado Pago (Painel > Suas integrações > Credenciais).
# Use as credenciais de TESTE enquanto desenvolve e as de PRODUÇÃO para cobrar de verdade.
# Usado quando a estação NÃO tem parceiro conectado (a plataforma fica com 100% do valor).
MP_ACCESS_TOKEN=

# Credenciais do app registrado como MARKETPLACE no Mercado Pago (Painel > Suas integrações >
# sua aplicação > OAuth). Necessárias para conectar a conta dos parceiros (donos de estação) e
# fazer o split automático de pagamento (comissão da plataforma + repasse ao parceiro).
MP_CLIENT_ID=
MP_CLIENT_SECRET=

# Comissão padrão (%) retida pela plataforma em pagamentos de estações com parceiro conectado.
# Pode ser sobrescrita por parceiro ao cadastrá-lo.
COMISSAO_PADRAO_PERCENTUAL=15

# E-mails (separados por vírgula) que viram administrador automaticamente ao logar/cadastrar.
# Ex.: ADMIN_EMAILS=voce@empresa.com,socio@empresa.com
ADMIN_EMAILS=

# Distância (em metros) que o motorista precisa se afastar da estação para o app liberar
# a vaga automaticamente via GPS, após um pagamento aprovado.
DISTANCIA_LIBERACAO_VAGA_METROS=300

# Chave da API do Google Maps JavaScript API (Google Cloud Console), restrita por referrer/HTTP.
GOOGLE_MAPS_API_KEY=

# URL pública onde o app está rodando (usada nos retornos do checkout e no webhook).
# Em desenvolvimento local: http://127.0.0.1:8000
# Para testar pagamento/webhook e GPS no celular, use uma URL HTTPS pública (ex.: ngrok).
APP_BASE_URL=http://127.0.0.1:8000
